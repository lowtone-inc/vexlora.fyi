---
import type { GetStaticPaths } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostGrid from '@/components/PostGrid.astro';
import { getTagGroups } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const groups = await getTagGroups();
  return groups.map((group) => ({ params: { tag: group.slug }, props: { group } }));
}) satisfies GetStaticPaths;

const { group } = Astro.props;
---

<PageLayout title={`#${group.name}`} label="Tag" description={`${group.posts.length}개의 글`}>
  <PostGrid posts={group.posts} />
</PageLayout>
