---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';
---

<BaseLayout title="404" noindex>
  <section class="container notfound">
    <p class="display code">4<span class="accent">0</span>4</p>
    <p>찾는 페이지가 없습니다.</p>
    <a href={withBase('/')}>← Home</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: 120px;
    text-align: center;
  }
  .code {
    margin: 0;
    font-size: clamp(8rem, 30vw, 16rem);
  }
  a {
    color: var(--c-accent);
    font-weight: 700;
  }
</style>
