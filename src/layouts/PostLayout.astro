---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '@/components/PostMeta.astro';
import PostNav from '@/components/PostNav.astro';
import TagList from '@/components/TagList.astro';
import { withBase } from '@/lib/url';
import type { Post } from '@/lib/posts';

export interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, tags, pubDate, updatedDate } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
>
  <article>
    <header class="post-hero">
      <div class="container">
        <a href={withBase('/blog/')} class="back">← All posts</a>
        <PostMeta post={post} />
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </div>
      <div class="stripe-bar"></div>
    </header>
    <div class="container content">
      <div class="prose">
        <slot />
      </div>
      {tags.length > 0 && <TagList tags={tags} />}
      <PostNav newer={newer} older={older} />
    </div>
  </article>
</BaseLayout>

<style>
  .post-hero {
    position: relative;
    background:
      linear-gradient(120deg, transparent 70%, var(--c-accent-dim) 70%),
      var(--c-surface);
  }
  .post-hero .container {
    padding-block: 56px 40px;
  }
  .back {
    display: inline-block;
    margin-bottom: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-muted);
    text-transform: uppercase;
  }
  .back:hover {
    color: var(--c-accent);
  }
  h1 {
    max-width: 24ch;
    margin: 12px 0;
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 900;
    line-height: 1.25;
  }
  .lead {
    max-width: 60ch;
    margin: 0;
    color: var(--c-muted);
  }
  .content {
    padding-top: 40px;
  }
  .prose {
    margin-bottom: 40px;
  }
</style>
