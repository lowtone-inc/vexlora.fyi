---
import { postUrl } from '@/lib/url';
import type { Post } from '@/lib/posts';

export interface Props {
  newer?: Post;
  older?: Post;
}

const links = [
  { post: Astro.props.older, label: '← 이전 글', align: 'left' },
  { post: Astro.props.newer, label: '다음 글 →', align: 'right' },
] as const;
---

<nav class="post-nav">
  {
    links.map(({ post, label, align }) =>
      post ? (
        <a href={postUrl(post.id)} class={align}>
          <span>{label}</span>
          <strong>{post.data.title}</strong>
        </a>
      ) : (
        <div />
      ),
    )
  }
</nav>

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    transition: border-color 0.2s;
  }
  a:hover {
    border-color: var(--c-accent);
  }
  .right {
    text-align: right;
  }
  span {
    font-size: 0.8rem;
    color: var(--c-accent);
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
