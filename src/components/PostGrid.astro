---
import PostCard from './PostCard.astro';
import type { Post } from '@/lib/posts';

export interface Props {
  posts: Post[];
  empty?: string;
}

const { posts, empty = '아직 작성된 글이 없습니다.' } = Astro.props;
---

{
  posts.length > 0 ? (
    <div class="grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <p class="empty">{empty}</p>
  )
}

<style>
  .empty {
    color: var(--c-muted);
  }
</style>
